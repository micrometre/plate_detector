# Docker ignore file for PaddleDetection License Plate Recognition

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Environment variables
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Docker files (avoid recursive builds)
Dockerfile*
docker-compose*.yml
.dockerignore
Makefile

# Large model files that should be downloaded during build
*.pdmodel
*.pdiparams
*.pdiparams.info

# Temporary files
*.tmp
*.temp
*.log

# Large output directories (will be mounted as volumes)
output/
videos/

# Documentation that's not needed in container
*.md
docs/
examples/